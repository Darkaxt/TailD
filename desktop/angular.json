{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "projects": {"taild": {"projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {"build": {"builder": "@angular/build:application", "options": {
      "outputPath": "dist", "browser": "src/main.ts", "index": "src/index.html",
      "tsConfig": "tsconfig.json", "styles": ["src/styles.css"], "assets": []
    }, "configurations": {"production": {"outputHashing": "all", "sourceMap": false,
      "optimization": {"scripts":true,"styles":{"minify":true,"inlineCritical":false},"fonts":false},
      "budgets": [{"type": "initial", "maximumWarning": "650kB", "maximumError": "900kB"}]}}
  }}}}
}
